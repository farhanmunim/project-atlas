# ingest/ — warehouse pipeline (self-hosted Postgres + PostgREST). Copy to
# ingest/.env for local runs (.env is gitignored). In CI/Coolify these come from
# repo secrets / the Coolify resource's env vars. All SERVER-SIDE ONLY — never
# shipped to the browser.

# TfL Unified API key. NOTE: the scripts read BUS_API_KEY, but the GitHub
# Actions workflows bridge it from the repo's TFL_APP_KEY secret. For a LOCAL
# run, set BUS_API_KEY here to your TfL subscription key.
BUS_API_KEY=

# DVLA Vehicle Enquiry Service (VES) x-api-key — per-reg make/fuel/year.
DVLA_API_KEY=

# Warehouse write target (history + analytics) — PostgREST URL + the
# service_role-equivalent JWT (bypasses RLS so the pipeline can write freely).
WAREHOUSE_URL=
WAREHOUSE_SERVICE_KEY=

# BODS (Bus Open Data Service) API key — the continuous SIRI-VM vehicle
# collector (track-vehicles.js) behind the daily lost-mileage estimate.
# Same key as the Cloudflare Pages BODS_API_KEY secret.
BODS_API_KEY=
