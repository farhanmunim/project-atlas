# ingest/ — Supabase warehouse pipeline. Copy to ingest/.env for local runs
# (.env is gitignored). In CI these come from GitHub Actions repo secrets.
# All SERVER-SIDE ONLY — never shipped to the browser.

# TfL Unified API key. NOTE: the scripts read BUS_API_KEY, but the GitHub
# Actions workflows bridge it from the repo's TFL_APP_KEY secret. For a LOCAL
# run, set BUS_API_KEY here to your TfL subscription key.
BUS_API_KEY=

# DVLA Vehicle Enquiry Service (VES) x-api-key — per-reg make/fuel/year.
DVLA_API_KEY=

# Supabase write target (history + analytics).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
